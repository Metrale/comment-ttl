{
  "$schema": "https://raw.githubusercontent.com/oasis-tcs/sarif-spec/main/sarif-2.1/schema/sarif-schema-2.1.0.json",
  "version": "[version]",
  "runs": [
    {
      "tool": {
        "driver": {
          "name": "comment-ttl",
          "version": "[version]",
          "informationUri": "https://github.com/Metrale/comment-ttl",
          "rules": [
            {
              "id": "stale",
              "name": "Stale comment",
              "shortDescription": {
                "text": "The comment's verification date is older than the configured TTL."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "undated",
              "name": "Undated comment",
              "shortDescription": {
                "text": "The comment does not start with a YYYY-MM-DD verification date."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "malformed",
              "name": "Malformed date or escape",
              "shortDescription": {
                "text": "The comment starts with an invalid date, or uses `no-rot` without a reason."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "future",
              "name": "Future-dated comment",
              "shortDescription": {
                "text": "The comment is dated more than one day after the reference date."
              },
              "defaultConfiguration": {
                "level": "error"
              }
            },
            {
              "id": "expiring",
              "name": "Expiring comment",
              "shortDescription": {
                "text": "The comment will pass its TTL within the warn_within window."
              },
              "defaultConfiguration": {
                "level": "warning"
              }
            },
            {
              "id": "escape",
              "name": "Escaped comment",
              "shortDescription": {
                "text": "The comment opted out of dating with a `no-rot:` reason."
              },
              "defaultConfiguration": {
                "level": "note"
              }
            }
          ]
        }
      },
      "originalUriBaseIds": {
        "%SRCROOT%": {
          "uri": "file:///"
        }
      },
